projection;
strict ( 2 );

define behavior for ZC_CAPEXAFE_001 alias AFEHeader
{
  use create;
  use update;
  use delete;

  use action Submit;
  use action Reopen;

  use draft action Activate;
  use draft action Discard;
  use draft action Edit;
  use draft action Resume;
  use draft action Prepare;

  use association _Items { create; }
}

define behavior for ZC_AFE_ITEM alias AFEItem
{
  use update;
  use delete;

  use association _Header;
}

managed implementation in class ZBP_R_CAPEXAFE_001 unique;
strict ( 2 );

define behavior for ZR_CAPEXAFE_001 alias AFEHeader
persistent table zcapexafe_001
draft table zcapexafe_001_d
lock master total etag LastChangedAt
authorization master ( global )
etag master LocalLastChangedAt
{
  field ( numbering : managed, readonly ) AfeUuid;
  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( readonly ) ProjectName, ProjectStartDate, TotalInvestment, ItemizedTotal;

  create;
  update;
  delete;

  // ── Draft Actions ──
  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  // ── Determinations ──
  determination deriveProjectDetails on modify { field ProjectId; }
  determination calculateTotals on modify { field CapitalAmount, ExpenseAmount,
    ItemBuilding, ItemProcessLab, ItemFurniture, ItemItInfra, ItemCafeFurn,
    ItemIdFee, ItemPmFee, ItemAdvisorFee, ItemLowValue, ItemRiskInfl,
    ItemInsDeduct, ItemMisc, ItemElectric; }

  // ── Validations ──
  validation checkProject on save { field ProjectId; create; }
  validation checkBudgetFlags on save { field IsBudgeted, IsUnbudgeted; create; update; }

  // ── Custom Actions ──
  action Submit result [1] $self;
  action Reopen result [1] $self;

  // ── Composition ──
  association _Items { create; }

  mapping for zcapexafe_001
  {
    AfeUuid            = afe_uuid;
    ProjectId          = project_id;
    ProjectName        = project_name;
    ProjectStartDate   = project_start_date;
    PurpAddition       = purp_addition;
    PurpRepair         = purp_repair;
    PurpReplacement    = purp_replacement;
    PurpExpansion      = purp_expansion;
    PurpCostReduct     = purp_cost_reduct;
    PurpNewLine        = purp_new_line;
    PurpRetirement     = purp_retirement;
    PurpOther          = purp_other;
    ChkBeforeTax       = chk_before_tax;
    ChkAfterTax        = chk_after_tax;
    IsBudgeted         = is_budgeted;
    IsUnbudgeted       = is_unbudgeted;
    RequestedBy        = requested_by;
    RequestedDesg      = requested_desg;
    RequestedDept      = requested_dept;
    SignedBy           = signed_by;
    StartDate          = start_date;
    EndDate            = end_date;
    ProductDesc        = product_desc;
    ReasonExp          = reason_exp;
    AltConsidered      = alt_considered;
    CapitalAmount      = capital_amount;
    ExpenseAmount      = expense_amount;
    TotalInvestment    = total_investment;
    AnnualEarning      = annual_earning;
    ExchangeRate       = exchange_rate;
    PaybackPeriod      = payback_period;
    Currency           = currency;
    ItemBuilding       = item_building;
    ItemProcessLab     = item_process_lab;
    ItemFurniture      = item_furniture;
    ItemItInfra        = item_it_infra;
    ItemCafeFurn       = item_cafe_furn;
    ItemIdFee          = item_id_fee;
    ItemPmFee          = item_pm_fee;
    ItemAdvisorFee     = item_advisor_fee;
    ItemLowValue       = item_low_value;
    ItemRiskInfl       = item_risk_infl;
    ItemInsDeduct      = item_ins_deduct;
    ItemMisc           = item_misc;
    ItemElectric       = item_electric;
    ItemizedTotal      = itemized_total;
    OverallStatus      = overall_status;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

define behavior for ZI_AFE_ITEM alias AFEItem
persistent table ztb_afe_itm
draft table zcapexafe_001_d
lock dependent by _Header
authorization dependent by _Header
etag master LocalLastChangedAt
{
  field ( numbering : managed, readonly ) ItemUuid;
  field ( readonly ) ParentUuid;
  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;

  update;
  delete;

  association _Header;

  mapping for ztb_afe_itm
  {
    ItemUuid        = item_uuid;
    ParentUuid      = parent_uuid;
    ItemCategory    = item_category;
    ItemDescription = item_description;
    ItemAmount      = item_amount;
    Quantity        = quantity;
    UnitPrice       = unit_price;
    Currency        = currency;
    Notes           = notes;
    CreatedBy       = created_by;
    CreatedAt       = created_at;
    LastChangedBy   = last_changed_by;
    LastChangedAt   = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}
